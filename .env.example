# ── LibreDTE ─────────────────────────────────────────────────────────────────
# Hash de usuario de 32 caracteres (Configuración > Perfil en LibreDTE)
LIBREDTE_HASH=tu_hash_de_32_caracteres_aqui

# URL de LibreDTE (dejar vacío para usar la nube oficial https://libredte.cl)
LIBREDTE_URL=

# RUT del contribuyente (sin puntos, sin DV) — ej: 76192083
LIBREDTE_RUT=

# Ambiente SII: "produccion" o "pruebas"
LIBREDTE_AMBIENTE=produccion

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_un_valor_aleatorio_de_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Base de datos ─────────────────────────────────────────────────────────────
# SQLite para desarrollo; Postgres para producción:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/libredte
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
